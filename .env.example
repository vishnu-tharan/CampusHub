# MongoDB Connection String (local MongoDB or free cloud MongoDB Atlas URI)
MONGODB_URI="mongodb://127.0.0.1:27017/campushub"
BETTER_AUTH_URL="http://localhost:3001"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Required only when explicitly running the development seed.
SEED_DEMO_PASSWORD="CampusHub-Demo-2026!"
# Event input and display timezone. Forms explicitly use this timezone, not browser time.
CAMPUS_TIME_ZONE="Asia/Colombo"
